        "from": "config",
        "to": "create"
      },
      {
        "from": "create",
        "to": "allocate"
      },
      {
        "from": "allocate",
        "to": "init",
        "label": "OU"
      },
      {
        "from": "allocate",
        "to": "load",
        "label": "OU"
      },
      {
        "from": "init",
        "to": "forward"
      },
      {
        "from": "load",
        "to": "forward"
      },
      {
        "from": "forward",
        "to": "train"
      },
      {
        "from": "forward",
        "to": "infer"
      },
      {
        "from": "train",
        "to": "save"
