[
  {
    "file": "03_model_lifecycle.svg",
    "title": "Cycle de vie du modèle natif",
    "subtitle": "Créer la structure, allouer, puis initialiser ou charger les poids.",
    "description": "Le registre construit une classe C++ dérivée de Model. Les paramètres sont alloués avant une initialisation neuve ou un chargement compatible. Le modèle est ensuite utilisé en entraînement ou en inférence, puis sauvegardé.",
    "columns": 3,
    "nodes": [
      {
        "id": "config",
        "title": "Architecture et config",
        "lines": [
          "Classe C++ dérivée de Model",
          "Valeurs autorisées du run"
        ],
        "row": 0,
        "col": 0,
        "tone": "purple"
      },
      {
        "id": "create",
        "title": "Créer via le registre",
        "lines": [
          "Model.create(name, cfg)",
          "Construction native du graphe"
        ],
        "row": 0,
        "col": 1,
        "tone": "purple"
      },
      {
        "id": "allocate",
        "title": "Allouer les paramètres",
        "lines": [
          "allocate_params()",
          "Avant init ou chargement"
        ],
        "row": 0,
        "col": 2,
        "tone": "teal"
      },
      {
        "id": "init",
        "title": "Nouveau départ",
        "lines": [
          "init_weights(méthode, seed)",
          "Poids initialisés une fois"
        ],
        "row": 1,
        "col": 0,
        "tone": "blue",
        "badge": "NOUVEAU RUN"
      },
      {
        "id": "forward",
        "title": "Exécuter le modèle",
        "lines": [
          "forward(entrées, training)",
          "Tenseurs et sorties nommés"
        ],
        "row": 1,
        "col": 1,
        "tone": "teal"
      },
      {
        "id": "load",
        "title": "Charger un checkpoint",
        "lines": [
          "Serialization.load(...)",
          "Topologie et assets compatibles"
        ],
        "row": 1,
        "col": 2,
        "tone": "orange",
        "badge": "REPRISE / INFÉRENCE"
      },
      {
        "id": "train",
        "title": "Entraîner",
        "lines": [
          "Loss → backward → optimizer",
          "Validation sans mise à jour"
