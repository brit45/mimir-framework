        "row": 2,
        "col": 1,
        "tone": "purple"
      },
      {
        "id": "infer",
        "title": "Faire une inférence",
        "lines": [
          "training = false",
          "Décoder ou post-traiter"
        ],
        "row": 2,
        "col": 2,
        "tone": "slate"
      }
    ],
    "edges": [
