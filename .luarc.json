{
  "$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
  "runtime.version": "Lua 5.3",
  "runtime.path": [
    "?.lua",
    "?/init.lua"
  ],
  "workspace.library": [
    "ide/lua"
  ],
  "workspace.checkThirdParty": false,
  "diagnostics.globals": [
    "model",
    "architectures",
    "flux",
    "FluxModel",
    "layers",
    "tokenizer",
    "dataset",
    "memory",
    "guard",
    "MemoryGuard",
    "allocator",
    "htop",
    "viz",
    "log",
    "read_json",
    "write_json",
    "Pipeline"
  ],
  "diagnostics.disable": [
    "lowercase-global"
  ],
  "completion.enable": true,
  "completion.callSnippet": "Both",
  "completion.keywordSnippet": "Both",
  "hint.enable": true,
  "hint.paramName": "All",
  "hint.setType": true,
  "format.enable": true,
  "format.defaultConfig": {
    "indent_style": "tab",
    "indent_size": "4"
  }
}
