{
  "$schema": "./configs/conf.schema.json",
  "description": "Lance l'entrainement PonyXL DDPM via --conf",
  "visualization": {
    "enabled": true
  },
  "logging": {
    "show_htop_display": false,
    "show_viz_display": true
  },
  "lua": {
    "scripts": [
      {
        "script": "scripts/training/ponyxl_ddpm_train.lua",
        "args": [
          "--dataset",
          "/media/brito/e580aa2a-30ca-4577-bc30-240b479f3af4/Datasets/coco/train2017" ,
          "--tokenizer",
          "checkpoint/base_tokenizer/tokenizer.json",
          "--max-vocab",
          "100000",
          "--tokenizer-compose-dataset",
          "true",
          "--tokenizer-growth-headroom",
          "8192",
          "--tokenizer-compose-log-every",
          "25",
          "--out-dir",
          "checkpoint/ponyxl_dppm.v1",
          "--arch",
          "ponyxl_ddpm",
          "--image-w",
          "512",
          "--image-h",
          "512",
          "--image-c",
          "3",
          "--vae-checkpoint",
          "checkpoint/vae_conv-generique.v5/epoch_0002_stop",
          "--vae-use-skip",
          "true",
          "--vae-use-prior",
          "true",
          "--vae-decoder-upsample",
          "conv_transpose",
          "--dtype",
          "float32",
          "--epochs",
          "5",
          "--lr",
          "1e-5",
          "--seed",
          "4242",
          "--validate-every-steps",
          "64",
          "--validate-items",
          "4",
          "--validate-holdout-frac",
          "0.1",
          "--seq_len",
          "75",
          "--log-every",
          "1",
          "--no-htop",
          "--viz"
        ]
      }
    ]
  }
}
